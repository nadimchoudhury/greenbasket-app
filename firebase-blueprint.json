{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Grocery store product item with stock level, cost and selling price, discount percentage, custom reorder threshold, supplier link, and cumulative sales stats.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the authenticated shop owner" },
        "name": { "type": "string", "description": "Product display name" },
        "barcode": { "type": "string", "description": "EAN/UPC barcode or SKU code" },
        "category": { "type": "string", "description": "Grocery category (Produce, Dairy, Bakery, Pantry, Beverages, Frozen, Household)" },
        "imageUrl": { "type": "string", "description": "Optional URI or image identifier" },
        "unit": { "type": "string", "description": "Unit of measure (kg, pc, pack, L, bottle, box)" },
        "costPrice": { "type": "number", "description": "Purchase cost per unit from supplier" },
        "sellingPrice": { "type": "number", "description": "Regular retail selling price per unit before discount" },
        "discountPercent": { "type": "number", "description": "Active discount percentage (0 to 100)" },
        "stockQuantity": { "type": "integer", "description": "Current units in stock" },
        "reorderThreshold": { "type": "integer", "description": "Custom low-stock threshold that triggers push alert" },
        "reorderQuantity": { "type": "integer", "description": "Default restock order quantity for supplier PO" },
        "supplierId": { "type": "string", "description": "Linked supplier document ID" },
        "supplierName": { "type": "string", "description": "Linked supplier display name" },
        "totalSoldUnits": { "type": "integer", "description": "Cumulative units sold across completed orders" },
        "totalRevenue": { "type": "number", "description": "Cumulative net revenue generated by this product" },
        "totalProfit": { "type": "number", "description": "Cumulative net profit generated by this product" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp via FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp via FieldValue.serverTimestamp()" }
      },
      "required": [
        "userId",
        "name",
        "barcode",
        "category",
        "unit",
        "costPrice",
        "sellingPrice",
        "discountPercent",
        "stockQuantity",
        "reorderThreshold",
        "reorderQuantity",
        "totalSoldUnits",
        "totalRevenue",
        "totalProfit",
        "createdAt",
        "updatedAt"
      ]
    },
    "CustomerOrder": {
      "title": "CustomerOrder",
      "description": "Walk-in POS checkout receipt or customer delivery/pickup order with line items, discount totals, COGS, and net profit.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the authenticated shop owner" },
        "orderNumber": { "type": "string", "description": "Human-readable order code" },
        "customerName": { "type": "string", "description": "Customer name or Walk-In Customer" },
        "customerPhone": { "type": "string", "description": "Customer phone number" },
        "deliveryAddress": { "type": "string", "description": "Delivery address for delivery orders" },
        "orderType": { "type": "string", "enum": ["WALK_IN", "DELIVERY"], "description": "Order fulfillment channel" },
        "status": { "type": "string", "enum": ["PENDING", "PACKED", "OUT_FOR_DELIVERY", "COMPLETED", "CANCELLED"], "description": "Order fulfillment lifecycle status" },
        "paymentMethod": { "type": "string", "enum": ["CASH", "CARD", "UPI"], "description": "Payment tender type" },
        "itemsSummary": { "type": "string", "description": "Summary string of purchased items" },
        "items": { "type": "array", "description": "Bounded list of order line item maps" },
        "totalItemsCount": { "type": "integer", "description": "Total units across line items" },
        "subtotal": { "type": "number", "description": "Gross subtotal before discounts" },
        "discountTotal": { "type": "number", "description": "Total discount deducted" },
        "totalAmount": { "type": "number", "description": "Net amount charged to customer" },
        "totalCost": { "type": "number", "description": "Total cost of goods sold (COGS)" },
        "netProfit": { "type": "number", "description": "Net profit (totalAmount - totalCost)" },
        "orderDateEpochDay": { "type": "integer", "description": "Epoch day integer for daily profit aggregation" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp via FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp via FieldValue.serverTimestamp()" }
      },
      "required": [
        "userId",
        "orderNumber",
        "customerName",
        "orderType",
        "status",
        "paymentMethod",
        "itemsSummary",
        "items",
        "totalItemsCount",
        "subtotal",
        "discountTotal",
        "totalAmount",
        "totalCost",
        "netProfit",
        "orderDateEpochDay",
        "createdAt",
        "updatedAt"
      ]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Wholesale grocery supplier profile for inventory restocking.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the authenticated shop owner" },
        "name": { "type": "string", "description": "Supplier company name" },
        "contactPerson": { "type": "string", "description": "Primary contact person" },
        "phone": { "type": "string", "description": "Contact phone number" },
        "email": { "type": "string", "description": "Contact email address" },
        "category": { "type": "string", "description": "Primary category supplied" },
        "address": { "type": "string", "description": "Warehouse or office address" },
        "leadTimeDays": { "type": "integer", "description": "Expected delivery lead time in days" },
        "notes": { "type": "string", "description": "Payment terms or delivery notes" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp via FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp via FieldValue.serverTimestamp()" }
      },
      "required": [
        "userId",
        "name",
        "contactPerson",
        "phone",
        "category",
        "leadTimeDays",
        "createdAt",
        "updatedAt"
      ]
    },
    "RestockOrder": {
      "title": "RestockOrder",
      "description": "Purchase order sent to a supplier to replenish low-stock inventory.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the authenticated shop owner" },
        "supplierId": { "type": "string", "description": "Supplier document ID" },
        "supplierName": { "type": "string", "description": "Supplier display name" },
        "productId": { "type": "string", "description": "Target product document ID" },
        "productName": { "type": "string", "description": "Target product name" },
        "barcode": { "type": "string", "description": "Target product barcode" },
        "quantityOrdered": { "type": "integer", "description": "Number of units ordered from supplier" },
        "unitCost": { "type": "number", "description": "Supplier unit cost" },
        "totalCost": { "type": "number", "description": "Total purchase order cost" },
        "status": { "type": "string", "enum": ["ORDERED", "RECEIVED", "CANCELLED"], "description": "Purchase order status" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp via FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp via FieldValue.serverTimestamp()" }
      },
      "required": [
        "userId",
        "supplierName",
        "productId",
        "productName",
        "quantityOrdered",
        "unitCost",
        "totalCost",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "ShopExpense": {
      "title": "ShopExpense",
      "description": "Operating expense entry (rent, utilities, spoilage, logistics) factored into net profit-loss analysis.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the authenticated shop owner" },
        "title": { "type": "string", "description": "Expense title" },
        "category": { "type": "string", "description": "Expense category (Utilities, Rent, Wastage, Packaging, Logistics, Staff)" },
        "amount": { "type": "number", "description": "Expense amount" },
        "notes": { "type": "string", "description": "Optional notes" },
        "expenseDateEpochDay": { "type": "integer", "description": "Epoch day integer for daily profit-loss calculation" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp via FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp via FieldValue.serverTimestamp()" }
      },
      "required": [
        "userId",
        "title",
        "category",
        "amount",
        "expenseDateEpochDay",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Store product catalog and real-time stock quantities scoped to userId."
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": { "$ref": "#/entities/CustomerOrder" },
      "description": "POS walk-in and customer delivery orders scoped to userId."
    },
    "/users/{userId}/suppliers/{supplierId}": {
      "schema": { "$ref": "#/entities/Supplier" },
      "description": "Supplier directory records scoped to userId."
    },
    "/users/{userId}/restock_orders/{restockId}": {
      "schema": { "$ref": "#/entities/RestockOrder" },
      "description": "Supplier purchase/restock orders scoped to userId."
    },
    "/users/{userId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/ShopExpense" },
      "description": "Daily shop operating expenses scoped to userId."
    }
  }
}
